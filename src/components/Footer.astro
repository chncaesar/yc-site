---
import { BEIAN_INFO, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<span class="footer-title">{SITE_TITLE}</span>
			<p class="footer-tagline">投给疗效，不投给流量</p>
		</div>
		<div class="footer-links">
			<a href="/articles">文章</a>
			<a href="/about">关于</a>
			<a href="/about#contact">联系</a>
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
	<div class="footer-bottom">
		<span>© {today.getFullYear()} {SITE_TITLE} · 版权所有</span>
		<a href={BEIAN_INFO.icp.href} target="_blank" rel="noopener" class="beian-link">{BEIAN_INFO.icp.label}</a>
		<a
			href={BEIAN_INFO.publicSecurity.href}
			target="_blank"
			rel="noopener"
			class="beian-link police-beian"
		>
			<img src={BEIAN_INFO.publicSecurity.logoSrc} alt={BEIAN_INFO.publicSecurity.logoAlt} />
			{BEIAN_INFO.publicSecurity.label}
		</a>
	</div>
</footer>

<style>
	footer {
		background: var(--green-dark);
		color: rgba(247,243,236,0.7);
		margin-top: 4em;
	}

	.footer-inner {
		max-width: var(--max-wide);
		margin: 0 auto;
		padding: 2.5em 1.5em 1.5em;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2em;
		flex-wrap: wrap;
	}

	.footer-title {
		font-family: var(--font-serif);
		font-size: 1.1em;
		font-weight: 700;
		color: var(--gold);
		display: block;
		margin-bottom: 0.3em;
	}

	.footer-tagline {
		margin: 0;
		font-size: 0.85em;
		color: rgba(247,243,236,0.5);
	}

	.footer-links {
		display: flex;
		gap: 1.5em;
		flex-wrap: wrap;
		align-items: center;
	}

	.footer-links a {
		color: rgba(247,243,236,0.7);
		text-decoration: none;
		font-size: 0.9em;
		transition: color 0.2s;
	}

	.footer-links a:hover {
		color: var(--gold);
	}

	.footer-bottom {
		max-width: var(--max-wide);
		margin: 0 auto;
		padding: 1em 1.5em;
		border-top: 1px solid rgba(201,168,76,0.2);
		font-size: 0.8em;
		color: rgba(247,243,236,0.4);
		display: flex;
		align-items: center;
		gap: 0.9em;
		flex-wrap: wrap;
	}

	.beian-link {
		text-decoration: none;
		color: rgba(247,243,236,0.4);
		transition: color 0.2s;
	}

	.beian-link:hover {
		color: var(--gold);
	}

	.police-beian {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
	}

	.police-beian img {
		width: 1.1em;
		height: 1.1em;
		border-radius: 0;
		flex: 0 0 auto;
	}

	@media (max-width: 480px) {
		.footer-inner {
			flex-direction: column;
			gap: 1.5em;
		}
	}
</style>
